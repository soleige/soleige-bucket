            "hash": "6be72d663b4665e369c75464a78a28941e171c9bcbb4445a19bd75f473899630"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.yaml\")) { ",
        "    Set-Content -Path \"$persist_dir\\config.yaml\" -Value '' -Encoding UTF8",
        "}"
    ],
    "persist": "config.yaml",
    "bin": "cli-proxy-api.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v$version/CLIProxyAPI_$version_windows_amd64.zip"
            }
        }
    }
