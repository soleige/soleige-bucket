{
    "version": "2.4.7.0",
    "description": "An all-in-one, free screenshot tool with annotation, pinning, OCR and recording features.",
    "homepage": "https://pixpin.cn/",
    "license": "Proprietary",
    "url": "https://download.pixpin.cn/PixPin_cn_zh-cn_2.4.7.0.zip",
    "hash": "7932835a23a5d9c8a31c7512970c5cb20bbea5cd20ce96681eb9753598aecd84",
    "extract_dir": "PixPin",
    "post_install": [
        "$ConfigPath = Join-Path -Path \"$persist_dir\\Config\" -ChildPath \"PixPinConfig.json\"",
        "if (-not (Test-Path $ConfigPath)) {",
        "    $CurrentUnixTime = [int][Math]::Floor((Get-Date -Date (Get-Date).ToUniversalTime() -UFormat %s))",
        "    $ConfigContent = @{",
        "        'System.Update.UpgradeMode#s.win' = @{",
        "            v = 0",
        "            t = $CurrentUnixTime",
        "        }",
        "    }",
        "    $ConfigContent | ConvertTo-Json -Depth 5 -Compress | Out-File -FilePath $ConfigPath -Encoding UTF8 -Force",
        "}"
    ],
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "persist": [
        "Config",
        "Data",
        "History",
        "Temp"
    ],
    "checkver": {
        "url": "https://pixpin.cn/download/",
        "regex": "PixPin_cn_zh-cn_([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "url": "https://download.pixpin.cn/PixPin_cn_zh-cn_$version.zip"
    }
}
