            "hash": "sha512:4095b7ff4caa0adce02d0040530c1cfcfc4a38864873a3dabb17277c3062981a1bbb646ef2e7623a77601bb658de00fe524df200c682fc9e86049f33ce984034",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v1.9.13/Cherry-Studio-1.9.13-arm64-setup.exe#/dl.7z",
            "hash": "9f49bbfd13575f18d71d2d29b89111a43f4d06db1c4634865abacbf4197e27be",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\""
