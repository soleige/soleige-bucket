        "arm64": {
            "url": "https://github.com/readest/readest/releases/download/v0.10.2/Readest_0.10.2_arm64-portable.exe#/Readest.exe",
            "hash": "17749c81bdead074d4e5c1b60295f0697e2a9ba15ece591e9309d14b9721218d"
        }
    },
    "pre_install": [
        "$persist_dir = \"$scoopdir\\persist\\$app\"",
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
        "# 确保文件夹存在",
        "if (!(Test-Path \"$persist_dir\\readest\")) { New-Item -Path \"$persist_dir\\readest\" -ItemType Directory -Force | Out-Null }",
        "# 确保配置文件存在且不是空文件（初始化为 {}）",
        "foreach ($file in @('settings.json', 'settings.json.bak')) {",
        "    $file_path = \"$persist_dir\\$file\"",
        "    if (!(Test-Path $file_path)) { ",
        "        Set-Content -Path $file_path -Value '{}' -Encoding UTF8",
        "    }",
        "}"
    ],
    "persist": [
        "readest",
        "settings.json",
        "settings.json.bak"
    ],
    "shortcuts": [
        [
            "Readest.exe",
            "Readest"
        ]
    ],
    "checkver": {
        "github": "https://github.com/readest/readest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_x64-portable.exe#/Readest.exe"
            },
            "arm64": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_arm64-portable.exe#/Readest.exe"
            }
        }
    }
}
